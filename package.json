{
  "name": "ausgabenrechner",
  "version": "1.5.1",
  "description": "Ausgabenrechner mit Cloudflare D1 und Ende-zu-Ende-Verschlüsselung",
  "scripts": {
    "dev": "npx wrangler pages dev . --d1 DB=ausgabenrechner-db",
    "db:init:local": "npx wrangler d1 execute ausgabenrechner-db --local --file=./schema.sql",
    "db:init:remote": "npx wrangler d1 execute ausgabenrechner-db --remote --file=./schema.sql",
    "deploy:pages": "npx wrangler pages deploy . --project-name ausgabenrechner --commit-dirty=true",
    "deploy:worker": "npx wrangler deploy -c wrangler.worker.toml",
    "deploy": "npm run deploy:pages && npm run deploy:worker"
  },
  "devDependencies": {
    "wrangler": "^4.156.0"
  }
}